    "@midwayjs/swagger": "^3.20.0",
    "@midwayjs/typeorm": "^3.20.0",
    "@midwayjs/upload": "^3.20.0",
    "@midwayjs/validate": "^3.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
